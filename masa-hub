    -- ============================================
    -- Kiki Hub Magic Circle Heartbeat
    -- ============================================
    RunService.Heartbeat:Connect(function()
        if not Config.Kiki.Enabled or Config.Kiki.Mode == "None" then return end
        local hrp = kikiGetTargetHRP()
        if not hrp then return end

        local baseCenterPos = hrp.Position + (hrp.CFrame.RightVector * Config.Kiki.OffsetX) + (hrp.CFrame.LookVector * Config.Kiki.OffsetY)
        kikiTimeCounter = kikiTimeCounter + Config.Kiki.Speed

        local currentParts = {}
        for o in pairs(kikiObjectData) do table.insert(currentParts, o) end
        local total = #currentParts
        if total == 0 then return end

        for i, o in ipairs(currentParts) do
            if o and o.Parent and o:FindFirstChild("SyncForce") then
                local progress = i / total
                local angle = progress * math.pi * 2
                local w = Config.Kiki.Width
                local h = Config.Kiki.Height
                local tc = kikiTimeCounter
                local mode = Config.Kiki.Mode
                local targetPos = kikiCalcPattern(mode, tc, angle, w, h)

                if targetPos then
                    o.SyncForce.Velocity = (baseCenterPos + targetPos - o.Position) * 18
                    o.SyncGyro.CFrame = hrp.CFrame
                end
                if math.random() > 0.95 then pcall(function() o:SetNetworkOwner(Player) end) end
            else
                kikiObjectData[o] = nil; kikiHoveringObjects[o] = nil
            end
        end
    end)

