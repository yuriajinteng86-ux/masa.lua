    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    task.wait(0.1)
    forceSpeed()
    forceJump()
    humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if humanoid.WalkSpeed ~= currentWalkSpeed then
            humanoid.WalkSpeed = currentWalkSpeed
        end
    end)
    humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if humanoid.JumpPower ~= currentJumpPower then
            humanoid.JumpPower = currentJumpPower
        end
    end)
    humanoid:GetPropertyChangedSignal("JumpHeight"):Connect(function()
        local target = currentJumpPower / 10
        if humanoid.JumpHeight ~= target then
            humanoid.JumpHeight = target
        end
    end)
end

