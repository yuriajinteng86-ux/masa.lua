    local function connectKikiCharacter(char)
        char:WaitForChild("HumanoidRootPart")
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("BasePart") then
                v.Touched:Connect(function(hit)
                    if Config.Kiki.Enabled then kikiRegisterPart(hit) end
                end)
            end
        end
    end
    Player.CharacterAdded:Connect(connectKikiCharacter)
    if Player.Character then connectKikiCharacter(Player.Character) end

