-- Anti Network Ownership (Ghost)
local function runAntiNetworkOwnership()
    local targetObjectName = "FoodHamburger"
    local teleportHeight = 15000000
    local playerToysFolderName = Player.Name .. "SpawnedInToys"
    while Config.ExtendedAnti.AntiNetworkOwnership do
        local toyFolder = Workspace:FindFirstChild(playerToysFolderName)
        local targetToy = toyFolder and toyFolder:FindFirstChild(targetObjectName)
        if not targetToy then
            local char = Player.Character
            local spawnCF = (char and char.PrimaryPart) and char.PrimaryPart.CFrame or CFrame.new(0, 5, 0)
            pcall(function()
                ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(targetObjectName, spawnCF, Vector3.new(0, 90, 0))
            end)
            for _ = 1, 20 do
                toyFolder = Workspace:FindFirstChild(playerToysFolderName)
                targetToy = toyFolder and toyFolder:FindFirstChild(targetObjectName)
                if targetToy then break end
                task.wait()
            end
        end
        if targetToy then
            local holdPart = targetToy:FindFirstChild("HoldPart")
            if holdPart then
                local holdRemote = holdPart:FindFirstChild("HoldItemRemoteFunction")
                local dropRemote = holdPart:FindFirstChild("DropItemRemoteFunction")
                if holdRemote and dropRemote then
                    local targetCF = CFrame.new(Vector3.new(0, teleportHeight, 0))
                    pcall(function()
                        holdRemote:InvokeServer(targetToy, Player.Character)
                        dropRemote:InvokeServer(targetToy, targetCF, targetCF)
                    end)
                end
            end
            for _, part in pairs(targetToy:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    part.CanTouch = false
                end
            end
        end
        task.wait()
    end
    local toyFolder = Workspace:FindFirstChild(playerToysFolderName)
    local targetToy = toyFolder and toyFolder:FindFirstChild(targetObjectName)
    if targetToy then
        pcall(function()
            ReplicatedStorage.MenuToys.DestroyToy:FireServer(targetToy)
        end)
    end
end

-- Anti Network Break
local function processHoldPart(item)
    if not item or not item:IsA("Instance") then return end
    local myToyFolder = Workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
    if myToyFolder and item:IsDescendantOf(myToyFolder) then return end
    task.spawn(function()
        local hp = item:FindFirstChild("HoldPart") or item:WaitForChild("HoldPart", 2)
        if not hp then return end
        local holdFunc = hp:FindFirstChild("HoldItemRemoteFunction")
        local dropFunc = hp:FindFirstChild("DropItemRemoteFunction")
        if not holdFunc or not dropFunc then return end
        local targetCF = CFrame.new(0, -9.9e9, 0)
        local grabEvents = ReplicatedStorage:WaitForChild("GrabEvents", 5)
        local endGrabRemote = grabEvents and grabEvents:FindFirstChild("EndGrabEarly")
        while Config.ExtendedAnti.AntiNetworkBreak and item.Parent and hp.Parent == item do
            local char = Player.Character
            if char then
                pcall(function() holdFunc:InvokeServer(item, char) end)
                task.wait(0.05)
                pcall(function()
                    for _ = 1, 2 do
                        dropFunc:InvokeServer(item, targetCF, targetCF)
                    end
                end)
                if endGrabRemote then
                    pcall(function() endGrabRemote:FireServer() end)
                end
            end
            task.wait(0.1)
        end
    end)
end

local function setupAntiNetworkBreak(state)
    if antiNetworkBreakConn then
        antiNetworkBreakConn:Disconnect()
        antiNetworkBreakConn = nil
    end
    if not state then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "HoldPart" and obj.Parent then
            processHoldPart(obj.Parent)
        end
    end
    antiNetworkBreakConn = Workspace.DescendantAdded:Connect(function(child)
        if child.Name == "HoldPart" and child.Parent then
            task.defer(function()
                if Config.ExtendedAnti.AntiNetworkBreak and child.Parent then
                    processHoldPart(child.Parent)
                end
            end)
        end
    end)
end

-- Perm Ragdoll
local function findRagdollRemote()
    local rem = ReplicatedStorage:FindFirstChild("RagdollRemote")
    if rem then return rem end
    local folder = ReplicatedStorage:FindFirstChild("CharacterEvents")
    if folder then
        rem = folder:FindFirstChild("RagdollRemote")
        if rem then return rem end
    end
    return game:FindFirstChild("RagdollRemote", true)
end

local permRagdollWantJump = false
local permRagdollJumpConn = nil

local function startPermRagdoll()
    if permRagdollJumpConn then
        permRagdollJumpConn:Disconnect()
        permRagdollJumpConn = nil
    end
    permRagdollJumpConn = UserInputService.JumpRequest:Connect(function()
        if Config.ExtendedAnti.PermRagdoll then
            permRagdollWantJump = true
        end
    end)
    local remote = findRagdollRemote()
    while Config.ExtendedAnti.PermRagdoll do
        local char = Player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and remote then
            pcall(function()
                remote:FireServer(hrp, 1)
            end)
            local moveDir = hum.MoveDirection
            local velX = moveDir.X * 35
            local velZ = moveDir.Z * 35
            local velY = hrp.AssemblyLinearVelocity.Y
            if hum.Jump or permRagdollWantJump then
                if math.abs(hrp.AssemblyLinearVelocity.Y) < 1.5 then
                    velY = 52
                end
                permRagdollWantJump = false
            end
            if moveDir.Magnitude > 0 or velY == 52 then
                hrp.AssemblyLinearVelocity = Vector3.new(velX, velY, velZ)
            end
        end
        task.wait()
    end
    local char = Player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local remote = findRagdollRemote()
    if hrp and remote then
        pcall(function() remote:FireServer(hrp, 0) end)
    end
    if permRagdollJumpConn then
        permRagdollJumpConn:Disconnect()
        permRagdollJumpConn = nil
    end
end

-- Anti Blobman Kill
local function runAntiBlobmanKill()
    while Config.ExtendedAnti.AntiBlobmanKill do
        local char = Player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                hum.Sit = true
                pcall(function()
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end)
                local cam = Workspace.CurrentCamera
                if cam then
