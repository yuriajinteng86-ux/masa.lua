    return nil
end

local function getRootPart()
    local char = Player.Character
    if char then
        return char:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function forceSpeed()
    local humanoid = getHumanoid()
    if humanoid and humanoid.WalkSpeed ~= currentWalkSpeed then
        humanoid.WalkSpeed = currentWalkSpeed
    end
end

local function forceJump()
    local humanoid = getHumanoid()
    if humanoid then
        pcall(function()
            humanoid.JumpPower = currentJumpPower
        end)
        pcall(function()
            humanoid.JumpHeight = currentJumpPower / 10
        end)
    end
end

local function applyCFrameSpeed()
    local humanoid = getHumanoid()
    local root = getRootPart()
    if humanoid and root then
        local moveDir = humanoid.MoveDirection
        if moveDir.Magnitude > 0 then
            local speedMultiplier = currentWalkSpeed / 16
            if speedMultiplier > 1 then
                root.CFrame = root.CFrame + (moveDir * (currentWalkSpeed - 16) * 0.02)
            end
        end
    end
end

