-- Auto-save: save when any toggle/option changes
local function HookAutoSave()
    local toggleCount = 0
    local optionCount = 0

    for idx, toggle in pairs(Toggles or {}) do
        if toggle and toggle.OnChanged then
            toggleCount = toggleCount + 1
            toggle:OnChanged(function(Value)
                local s, e = SaveManager:Save("auto")
                if not s then
                    warn("[AutoSave Toggle " .. tostring(idx) .. "] " .. tostring(e))
                end
            end)
        end
    end

    for idx, opt in pairs(Options or {}) do
        if opt and opt.OnChanged then
            optionCount = optionCount + 1
            opt:OnChanged(function(Value)
                local s, e = SaveManager:Save("auto")
                if not s then
                    warn("[AutoSave Option " .. tostring(idx) .. "] " .. tostring(e))
                end
            end)
        end
    end

    Library:Notify({
        Title = "Auto-Save",
        Content = "Hooked " .. toggleCount .. " toggles, " .. optionCount .. " options",
        Duration = 3
    })
end

-- Auto-load config on startup
local function AutoLoadConfig()
    local success, err = SaveManager:Load("auto")
    if success then
        Library:Notify({
            Title = "Config Loaded",
            Content = "Auto config loaded successfully!",
            Duration = 3
        })
    else
        -- List available configs
        local listOk, configs = pcall(function()
            return SaveManager:RefreshConfigList()
        end)
        if listOk and configs and #configs > 0 then
            Library:Notify({
                Title = "Auto Config Not Found",
                Content = "Available: " .. table.concat(configs, ", "),
                Duration = 5
            })
        else
            Library:Notify({
                Title = "Auto Config Not Found",
                Content = "Use 'Save to Auto' to create one",
                Duration = 5
            })
        end
    end
end

-- Setup after all UI elements are created
task.delay(2, function()
    HookAutoSave()
    AutoLoadConfig()
end)


