                task.spawn(SnipeRagdoll, Config.Snipes.TargetPlayer)
            end
            if Config.Snipes.LoopDeath then
                task.spawn(SnipeDeath, Config.Snipes.TargetPlayer)
            end
            if Config.Snipes.LoopBring then
                task.spawn(SnipeBring, Config.Snipes.TargetPlayer)
            end
            if Config.Snipes.LoopPull then
                task.spawn(SnipePull, Config.Snipes.TargetPlayer)
            end
        end
        LoopTimer = 0
    end

    if AuraTimer >= 0.5 then
        local root = HRP()
        local hum = getHum()
        if root and hum and (Config.Aura.KillAura or Config.Aura.VoidAura or Config.Aura.RagdollAura or Config.Aura.NoclipAura) then
            for _, part in ipairs(GetNearParts(root.Position, Config.Aura.Radius)) do
                if part.Name == "HumanoidRootPart" and not part:IsDescendantOf(Player.Character) then
                    SetNetworkOwner(part)
                    if Config.Aura.KillAura then
                        MoveTo(part, CFrame.new(4096, -75, 4096))
                        Velocity(part, Vector3.new(0, -1000, 0))
                    end
                    if Config.Aura.VoidAura then
                        Velocity(part, Vector3.new(0, 10000, 0))
                    end
                    if Config.Aura.RagdollAura then
                        Velocity(part, Vector3.new(0, -256, 0))
                    end
                    if Config.Aura.NoclipAura then
                        part.CanCollide = false
                    end
                end
            end
        end
        AuraTimer = 0
    end

    if DefenseTimer >= 0.1 then
        if Config.Anti.AntiGrab or Config.Anti.StruggleSpam then
            Struggle()
        end
        if Config.Anti.AntiVoid then
            local hrp = HRP()
            if hrp and hrp.Position.Y < -80 then
                hrp.CFrame = CFrame.new(0, 10, 0)
            end
        end
        if Config.Anti.AntiRagdoll then
            local hum = getHum()
            if hum and hum:GetState() == Enum.HumanoidStateType.Ragdoll then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
        end
        if Config.Anti.AntiExplode then
            local myRoot = HRP()
            if myRoot then
                for _, part in ipairs(Workspace:GetChildren()) do
                    if part.Name == "Part" and myRoot then
                        local distance = (part.Position - myRoot.Position).Magnitude
                        if distance >= 4 then
                            myRoot.Anchored = true
                            task.wait(0.05)
                            Struggle()
                            task.wait()
                            myRoot.Anchored = false
                        end
                    end
                end
            end
        end
        DefenseTimer = 0
    end
end)

