-- ==================== DANCE V2 ====================
local DanceV2 = {
    rawTable = {},
    list = {},
    activeData = nil,
    selectedName = "",
    isDancing = false,
    conn = nil,
    frameIndex = 1,
    frameTimer = 0,
    skipParts = { HumanoidRootPart = true, Handle = true, LArmIKPart = true, RArmIKPart = true }
}

local function DanceV2ParseCFrame(t)
    return CFrame.new(t[1], t[2], t[3], t[4], t[5], t[6], t[7], t[8], t[9], t[10], t[11], t[12])
end

local function DanceV2Stop(char)
    if DanceV2.conn then
        DanceV2.conn:Disconnect()
        DanceV2.conn = nil
    end
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
            hum.AutoRotate = true
        end
    end
end

local function DanceV2Start(char)
    if not DanceV2.activeData then return end
    DanceV2Stop(char)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hrp or not hum then return end

    pcall(function()
        if ragdollRemote then
            ragdollRemote:FireServer(hrp, 9999999)
        else
            hum.PlatformStand = true
            hum.AutoRotate = false
        end
    end)

    local movePos = hrp.Position
    local walkSpeed = hum.WalkSpeed > 0 and hum.WalkSpeed or 16
    local threshold = 8
    local frames = DanceV2.activeData.frames
    local interval = DanceV2.activeData.interval
    local n = #frames
    if n == 0 then return end
    DanceV2.frameIndex = 1
    DanceV2.frameTimer = 0

    DanceV2.conn = RunService.Heartbeat:Connect(function(dt)
        if not char.Parent or not hrp.Parent then return end
        local look = Camera.CFrame.LookVector
        local yaw = math.atan2(-look.X, -look.Z)
        local curPos = hrp.Position
        if (curPos - movePos).Magnitude > threshold then
            movePos = curPos
        end
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0.01 then
            movePos = movePos + moveDir * walkSpeed * dt
        end
        local baseCF = CFrame.new(movePos) * CFrame.Angles(0, yaw, 0)
        hrp.CFrame = baseCF
        hrp.AssemblyLinearVelocity = Vector3.zero

        DanceV2.frameTimer = DanceV2.frameTimer + dt
        local wrapped = false
        if interval <= DanceV2.frameTimer then
            DanceV2.frameTimer = DanceV2.frameTimer - interval
            DanceV2.frameIndex = DanceV2.frameIndex + 1
            if DanceV2.frameIndex > n then
                DanceV2.frameIndex = 1
                wrapped = true
            end
        end

        local f1 = frames[DanceV2.frameIndex]
        local f2 = frames[DanceV2.frameIndex < n and (DanceV2.frameIndex + 1) or 1]
        local alpha = wrapped and 1 or (DanceV2.frameTimer / interval)

        for partName, data in pairs(f1.parts) do
            if not DanceV2.skipParts[partName] then
                local part = char:FindFirstChild(partName)
                if part and part:IsA("BasePart") then
                    local nextData = f2.parts[partName] or data
                    part.CFrame = baseCF * DanceV2ParseCFrame(data):Lerp(DanceV2ParseCFrame(nextData), alpha)
                    part.AssemblyLinearVelocity = Vector3.zero
                end
            end
        end
    end)
end

local function DanceV2Refresh()
    DanceV2.rawTable = {}
    pcall(function()
        local res = game:HttpGet("https://raw.githubusercontent.com/dcus-official/PoopHub/refs/heads/main/Assets/Emote/List_Json.lua")
        local chunk = loadstring(res)
        if chunk then
            local ok, tbl = pcall(chunk)
            if ok and type(tbl) == "table" then
                for k, v in pairs(tbl) do
                    DanceV2.rawTable[k] = v
                end
            end
        end
    end)

    pcall(function()
        if not isfolder("masa_hub_private") then makefolder("masa_hub_private") end
        if not isfolder("masa_hub_private/Dances") then makefolder("masa_hub_private/Dances") end
        local files = listfiles("masa_hub_private/Dances")
        for _, path in ipairs(files) do
            if path:match("%.dance$") then
                local name = path:gsub("\\", "/"):match("([^/]+)%.dance$")
                if name then
                    local ok, content = pcall(readfile, path)
                    if ok and content then
                        DanceV2.rawTable[name] = content
                    end
                end
            end
        end
    end)

    DanceV2.list = {}
    for k in pairs(DanceV2.rawTable) do
        table.insert(DanceV2.list, k)
    end
    table.sort(DanceV2.list)
    if #DanceV2.list == 0 then
        table.insert(DanceV2.list, "No dances found")
    end
    return DanceV2.list
end

local function DanceV2Select(name)
    if name == "No dances found" or name == "" then return end
    DanceV2.selectedName = name
    local raw = DanceV2.rawTable[name]
    if not raw then return end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if ok then
        DanceV2.activeData = decoded
        if DanceV2.isDancing and Player.Character then
            DanceV2Start(Player.Character)
        end
    end
